# dunstrc - notifications in the washed Tokyo Night palette used by i3.
# Reload after editing:  systemctl --user restart dunst

[global]
    monitor = 0
    follow = keyboard

    # Geometry: top-right of the focused monitor, matching i3's bar offset.
    width = 360
    height = (100, 300)
    origin = top-right
    offset = 16x16
    scale = 0
    notification_limit = 5

    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300

    indicate_hidden = yes
    transparency = 0
    separator_height = 2
    padding = 12
    horizontal_padding = 14
    text_icon_padding = 0
    frame_width = 2
    frame_color = "#82a1e4"
    gap_size = 8
    separator_color = frame
    sort = yes
    idle_threshold = 120

    font = Maple Mono NF 10
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    icon_position = left
    min_icon_size = 0
    max_icon_size = 32
    icon_path = /usr/share/icons/gnome/16x16/status/:/usr/share/icons/gnome/16x16/devices/
    enable_recursive_icon_lookup = true

    sticky_history = yes
    history_length = 20
    dmenu = /usr/bin/dmenu -p dunst:
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst
    corner_radius = 8
    ignore_dbusclose = false
    force_xinerama = false

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[experimental]
    per_monitor_dpi = false

# Background, foreground and frame colour per urgency. Defaults to the i3
# palette: muted blue for normal, red for critical, grey for low.
[urgency_low]
    background = "#1a1b26"
    foreground = "#9299ac"
    frame_color = "#565f80"
    timeout = 5

[urgency_normal]
    background = "#1a1b26"
    foreground = "#c2caec"
    frame_color = "#82a1e4"
    timeout = 8

[urgency_critical]
    background = "#1a1b26"
    foreground = "#c2caec"
    frame_color = "#e17c8f"
    timeout = 0
